{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["chrome", "node"],
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": { "@/*": ["../apps/web/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../apps/web/lib/**/*.ts",
    "../apps/web/components/ui.tsx"
  ],
  "exclude": ["../apps/web/lib/**/*.test.ts"]
}
