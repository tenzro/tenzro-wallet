{
  "name": "@tenzro/ui",
  "version": "0.1.0",
  "description": "Tenzro Wallet design system — React component library and design tokens for building Tenzro wallet UIs across the four VM surfaces (Tenzro native, EVM, SVM, Canton). Chain registry, balance hero, asset rows, agent-mandate cards, identity cards, and primitives.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/tokens/globals.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "1.1.10",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.7",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-separator": "1.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "motion": "12.38.0",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "vaul": "1.1.2",
    "cmdk": "1.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwindcss": "4.2.4",
    "tsup": "8.5.0",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tenzro",
    "wallet",
    "ui",
    "design-system",
    "react",
    "components",
    "tailwind",
    "evm",
    "solana",
    "canton",
    "ai-agents"
  ],
  "author": "Tenzro <eng@tenzro.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-wallet.git",
    "directory": "packages/ui"
  },
  "homepage": "https://tenzro.com",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
