{
  "name": "tenzro-wallet",
  "version": "0.3.0",
  "description": "Tenzro Wallet kernel: non-custodial passkey accounts (P-256 + ML-DSA-65, device linking, guardian recovery), hardware-rooted agents and machines, and one identity across the Tenzro native, EVM, SVM and Canton surfaces. Agent-payment ports, capital intents, bridge router, CAIP discovery.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./custody": {
      "types": "./dist/custody/passkey/index.d.ts",
      "import": "./dist/custody/passkey/index.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces/index.d.ts",
      "import": "./dist/surfaces/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@canton-network/core-ledger-proto": "^1.5.0",
    "@canton-network/core-tx-visualizer": "^1.5.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "tenzro-sdk": "^0.4.10"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tenzro",
    "wallet",
    "did",
    "tdip",
    "ed25519",
    "ml-dsa",
    "post-quantum",
    "passkey",
    "device-linking",
    "non-custodial",
    "webauthn",
    "evm",
    "solana",
    "canton",
    "daml",
    "ai-agents",
    "ap2",
    "x402",
    "mpp",
    "erc-8004",
    "erc-7802",
    "erc-7683",
    "eip-7702",
    "permit2",
    "secure-mint",
    "capital-intent",
    "saga-workflow",
    "caip",
    "bridge",
    "layerzero",
    "ccip",
    "wormhole",
    "debridge",
    "lifi",
    "hyperlane",
    "axelar",
    "babylon",
    "bitcoin-staking",
    "tenzro-train",
    "confidential-compute"
  ],
  "author": "Tenzro <eng@tenzro.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-wallet.git",
    "directory": "packages/wallet-kernel"
  },
  "homepage": "https://tenzro.com",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
