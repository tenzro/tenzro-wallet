{
  "name": "tenzro-wallet",
  "version": "0.2.2",
  "description": "Tenzro Wallet kernel — one identity, four VM surfaces (Tenzro native, EVM, SVM, Canton). Passkey-quorum custody, post-quantum signing, agent-payment ports, capital intents + multi-party workflows, EVM primitives (EIP-7702 / Permit2 / Secure-Mint / ERC-7683), eight-vendor bridge router, CAIP discovery, Babylon Bitcoin staking, Tenzro Train protocol port (Phase 4 Confidential-tier).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces/index.d.ts",
      "import": "./dist/surfaces/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "tenzro-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "typescript": "5.7.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tenzro",
    "wallet",
    "did",
    "tdip",
    "ed25519",
    "ml-dsa",
    "post-quantum",
    "passkey",
    "frost",
    "mpc",
    "evm",
    "solana",
    "canton",
    "daml",
    "ai-agents",
    "ap2",
    "x402",
    "mpp",
    "stripe-spt",
    "visa-tap",
    "mastercard-agent-pay",
    "erc-8004",
    "erc-7802",
    "erc-7683",
    "eip-7702",
    "permit2",
    "secure-mint",
    "capital-intent",
    "saga-workflow",
    "caip",
    "bridge",
    "layerzero",
    "ccip",
    "wormhole",
    "debridge",
    "lifi",
    "hyperlane",
    "axelar",
    "babylon",
    "bitcoin-staking",
    "tenzro-train",
    "confidential-compute"
  ],
  "author": "Tenzro <eng@tenzro.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-wallet.git",
    "directory": "packages/wallet-kernel"
  },
  "homepage": "https://tenzro.com",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
