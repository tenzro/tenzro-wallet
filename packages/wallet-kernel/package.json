{
  "name": "tenzro-wallet",
  "version": "0.1.0",
  "description": "Tenzro Wallet kernel — one identity, four VM surfaces (Tenzro native, EVM, SVM, Canton). Passkey-quorum custody, post-quantum signing, agent-payment ports, six-vendor bridge router.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./surfaces": {
      "types": "./dist/surfaces/index.d.ts",
      "import": "./dist/surfaces/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-dts-extensions.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "tenzro-sdk": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vitest": "4.1.5"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "tenzro",
    "wallet",
    "did",
    "tdip",
    "ed25519",
    "ml-dsa",
    "post-quantum",
    "passkey",
    "frost",
    "mpc",
    "evm",
    "solana",
    "canton",
    "daml",
    "ai-agents",
    "ap2",
    "x402",
    "erc-8004",
    "erc-7802",
    "bridge",
    "layerzero",
    "ccip",
    "wormhole",
    "debridge",
    "lifi"
  ],
  "author": "Tenzro <eng@tenzro.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tenzro/tenzro-wallet.git",
    "directory": "packages/wallet-kernel"
  },
  "homepage": "https://tenzro.com",
  "bugs": {
    "url": "https://github.com/tenzro/tenzro-wallet/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
