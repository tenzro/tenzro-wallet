# Wallet settings, read at build time. Nothing here is secret.
# Copy to apps/web/.env.local for development.

# Your WebAuthn relying party: the domain you serve the wallet on.
# NEXT_PUBLIC_WALLET_RP_ID=wallet.example

# The name the wallet shows.
# NEXT_PUBLIC_WALLET_NAME=Example Wallet

# Nodes to start from, comma-separated (hints only).
# NEXT_PUBLIC_WALLET_SEEDS=https://rpc1.tenzro.com,https://rpc2.tenzro.com

# The chain every node must answer for.
# NEXT_PUBLIC_WALLET_CHAIN_ID=13380

# A node of another operator to cross-check approval effects.
# NEXT_PUBLIC_WALLET_SECOND_RPC=https://rpc2.tenzro.com

# Optional sponsor for keystore changes of accounts that hold nothing yet.
# NEXT_PUBLIC_WALLET_SPONSOR_URL=https://wallet.example/sponsor
