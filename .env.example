# ─── Tenzro Wallet — environment template ───────────────────────────────────
# Copy this file to `.env` (gitignored) and fill in real values for local
# development or live integration tests.
#
# Nothing in `src/` reads these directly at runtime — host apps and tests pass
# values through the kernel's dep-injected ports. Keep secrets out of git.

# ─── Tenzro RPC ──────────────────────────────────────────────────────────────
# Base URL for the Tenzro JSON-RPC node (multi-VM ledger: native / EVM / SVM).
# Default in tests targets the public testnet. Self-hosted nodes work too.
TENZRO_RPC_URL=https://rpc.tenzro.network

# Optional: override chain id for the SDK client. Defaults to whatever the
# node reports. 1337 is the testnet chain id today.
# TENZRO_CHAIN_ID=1337

# DPoP-bound bearer JWT issued by Tenzro auth. Required by the native-VM
# `testnet.test.ts` smoke (the EVM/SVM smokes are read-only and don't need it).
# TENZRO_BEARER_JWT=replace-with-jwt

# Tenzro-shape (EVM-compatible 0x… 20-byte) address you own on the network.
# Used by:
#   - `testnet.test.ts` — 1-wei self-transfer (also needs TENZRO_BEARER_JWT).
#   - `evm-on-tenzro.test.ts` — read-only EVM nonce/balance probes.
#   - `svm-on-tenzro.test.ts` — read-only SVM balance probe (under the
#     pointer model the EVM and SVM views read against the same native
#     account, so one address covers both).
# TENZRO_TEST_ADDRESS=0x0000000000000000000000000000000000000000

# Optional smoke-test timeout, ms. Shared across all three Tenzro integration
# tests (testnet, evm-on-tenzro, svm-on-tenzro). Default 60s for testnet (full
# self-transfer round-trip), 30s for EVM/SVM (read-only).
# TENZRO_TEST_TIMEOUT_MS=60000

# ─── Canton MainNet validator ────────────────────────────────────────────────
# A Canton participant exposes two HTTP roots that share an Auth0 JWT.
# The wallet kernel's `LedgerApiAdapter` consumes both. Operators of the
# Tenzro-run validator (or their own) inject the URLs through host config —
# they're intentionally omitted here so this file stays free of deployment-
# specific endpoints. The audience for the JWT must equal
# `https://canton.network.global` regardless of where the validator is hosted.

# CANTON_LEDGER_BASE_URL=...        # JSON Ledger API root
# CANTON_VALIDATOR_BASE_URL=...     # Splice validator-app root
# CANTON_AUTH0_TOKEN=replace-with-jwt
# CANTON_USER_ID=replace-with-user-id
# CANTON_TEST_PARTY=replace-with-party-id

# Optional smoke-test timeout, ms.
# CANTON_TEST_TIMEOUT_MS=30000
